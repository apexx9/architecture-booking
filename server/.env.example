# Copy to .env and fill in. Never commit the real .env.

PORT=8000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Generate each with: openssl rand -base64 32
# The two must be different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

NODE_ENV=development

# Origin of the Next.js app. Used for CORS, OAuth redirects and email links.
FRONTEND_URL=http://localhost:3000

# Set COOKIE_SECURE=true whenever the app is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Email (Brevo) -------------------------------------------------------
# Required in production. When empty in development the mail URL is logged to
# stdout instead of being sent, so you can click through the flow locally.
BREVO_API_KEY=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Renove

# --- Social auth ---------------------------------------------------------
# Register the redirect URI shown here with each provider exactly, or the
# handshake fails at the consent screen. It must point at THIS server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:8000/auth/microsoft/callback
# `common` accepts any work or school account. Set a directory tenant ID to
# restrict sign-in to a single organisation.
MICROSOFT_TENANT_ID=common