FROM node:22-bookworm-slim

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Install the dependencies using the committed lockfile for repeatable builds.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Compile the NestJS TypeScript application.
COPY . .
RUN pnpm build

# Vercel supplies PORT at runtime; NestJS reads it through AppConfigService.
ENV NODE_ENV=production
CMD ["node", "dist/src/main.js"]
