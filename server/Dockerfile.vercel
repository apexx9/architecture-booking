# Build with the exact pnpm version declared in package.json.
FROM node:22-bookworm-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Install from the lockfile first to preserve Docker layer caching.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build && pnpm prune --prod

# Runtime image contains only production dependencies and compiled output.
FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
# Vercel container services listen on port 80 unless PORT is overridden.
ENV PORT=80

WORKDIR /app

COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist

USER node
EXPOSE 80

CMD ["node", "dist/src/main.js"]
